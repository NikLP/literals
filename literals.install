<?php

/**
 * @file
 * Install and update hooks for the literals module.
 */

declare(strict_types=1);

use Drupal\literals\Entity\Literal;

/**
 * Replaces the pool with an audience: public, signed-in users or a role.
 */
function literals_update_10001(): void {
  $manager = \Drupal::entityDefinitionUpdateManager();
  $entity_type = \Drupal::entityTypeManager()->getDefinition('literal');
  $audience = Literal::baseFieldDefinitions($entity_type)['audience'];
  $audience->setProvider('literals')->setName('audience')->setTargetEntityTypeId('literal');
  if (!$manager->getFieldStorageDefinition('audience', 'literal')) {
    $manager->installFieldStorageDefinition('audience', 'literal', 'literals', $audience);
  }

  // A public pool becomes public; any other pool becomes signed-in only.
  $database = \Drupal::database();
  $database->update('literal')->fields(['audience' => 'authenticated'])->execute();
  $database->update('literal')->fields(['audience' => 'public'])->condition('pool', 'public')->execute();
  $database->update('literal_revision')->fields(['audience' => 'authenticated'])->execute();
  $database->update('literal_revision')->fields(['audience' => 'public'])
    ->condition('revision_id', $database->select('literal', 'l')->fields('l', ['revision_id'])->condition('audience', 'public'), 'IN')
    ->execute();

  // Drop the pool field, then the pool config entity type and its config.
  if ($pool_field = $manager->getFieldStorageDefinition('pool', 'literal')) {
    $manager->uninstallFieldStorageDefinition($pool_field);
  }
  foreach (\Drupal::configFactory()->listAll('literals.literal_pool.') as $name) {
    \Drupal::configFactory()->getEditable($name)->delete();
  }
  $repository = \Drupal::service('entity.last_installed_schema.repository');
  if ($definition = $repository->getLastInstalledDefinition('literal_pool')) {
    $manager->uninstallEntityType($definition);
  }
}

/**
 * Renames the "public" audience to "anonymous".
 */
function literals_update_10002(): void {
  $database = \Drupal::database();
  foreach (['literal', 'literal_revision'] as $table) {
    $database->update($table)->fields(['audience' => 'anonymous'])->condition('audience', 'public')->execute();
  }
}

/**
 * Adds the literals.settings config (audit logging, off by default).
 */
function literals_update_10003(): void {
  $config = \Drupal::configFactory()->getEditable('literals.settings');
  if ($config->isNew()) {
    $config->set('log_audit', FALSE)->save();
  }
}

/**
 * Adds the literal audience config entities and grants them to roles.
 *
 * Audiences were a fixed list; they are now config with a generated
 * permission each. The shipped three keep the old behavior: "anonymous" to
 * every role, "authenticated" to signed-in users, and "restricted" stays on
 * the permission roles already hold under the same name.
 */
function literals_update_10004(): void {
  // Only the audiences: installDefaultConfig() would reset the settings.
  $storage = \Drupal::entityTypeManager()->getStorage('literal_audience');
  $weight = 0;
  foreach ([
    'anonymous' => ['Anonymous', 'Everyone, anonymous visitors included.'],
    'authenticated' => ['Signed-in users', 'Any signed-in account.'],
    'restricted' => ['Restricted', 'Only roles granted this audience explicitly.'],
  ] as $id => [$label, $description]) {
    if (!$storage->load($id)) {
      $storage->create(['id' => $id, 'label' => $label, 'description' => $description, 'weight' => $weight])->save();
    }
    $weight++;
  }
  literals_grant_default_audiences();
}

/**
 * Implements hook_install().
 */
function literals_install(): void {
  literals_grant_default_audiences();
}

/**
 * Grants the shipped audiences to the built-in roles.
 */
function literals_grant_default_audiences(): void {
  \Drupal::service('cache.discovery')->deleteAll();
  user_role_grant_permissions('anonymous', ['view anonymous literals']);
  user_role_grant_permissions('authenticated', ['view anonymous literals', 'view authenticated literals']);
}

/**
 * Keeps the per-audience permissions named "view {audience} literals".
 *
 * A reverted rename to "consume" left some sites with the longer name in
 * role config; this puts the grants back under "view". Config-level, because
 * saving a Role entity strips permissions that no longer exist.
 */
function literals_update_10005(): void {
  foreach (\Drupal::configFactory()->listAll('user.role.') as $name) {
    $config = \Drupal::configFactory()->getEditable($name);
    $before = $config->get('permissions') ?? [];
    $after = preg_replace('/^consume (.+) literals$/', 'view $1 literals', $before);
    if ($after !== $before) {
      $config->set('permissions', $after)->save();
    }
  }
}
